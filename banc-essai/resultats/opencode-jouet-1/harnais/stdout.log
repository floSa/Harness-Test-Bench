{"type":"tool_use","timestamp":1795122711211,"sessionID":"ses_e0a594e59ffec0m5MQYGM0VOQF","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-a7dfc498565f493c","state":{"status":"completed","input":{"filePath":"/travail/soumettre.py"},"output":"<path>/travail/soumettre.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Client de l'API de soumission du banc (bibliothèque standard seulement).\n2: \n3: Adresse : variable d'environnement BANC_API (par défaut http://127.0.0.1:8765).\n4: \n5:     python soumettre.py etat\n6:     python soumettre.py documents DOSSIER        télécharge les PDF du test caché dans DOSSIER\n7:     python soumettre.py soumettre DOSSIER        extraction : un fichier <id>.json par document\n8:                                                  jouet : le dossier du paquet Python\n9:     python soumettre.py fin --soumission N [--score-validation X] [--commande \"...\"]\n10: \"\"\"\n11: import argparse\n12: import json\n13: import os\n14: import sys\n15: import urllib.error\n16: import urllib.request\n17: from pathlib import Path\n18: \n19: API = os.environ.get(\"BANC_API\", \"http://127.0.0.1:8765\").rstrip(\"/\")\n20: \n21: \n22: def appel(methode, chemin, corps=None, brut=False):\n23:     donnees = None if corps is None else json.dumps(corps, ensure_ascii=False).encode()\n24:     req = urllib.request.Request(API + chemin, data=donnees, method=methode,\n25:                                  headers={\"Content-Type\": \"application/json\"})\n26:     try:\n27:         with urllib.request.urlopen(req, timeout=300) as r:\n28:             contenu = r.read()\n29:             return r.status, contenu if brut else json.loads(contenu)\n30:     except urllib.error.HTTPError as e:\n31:         return e.code, json.loads(e.read() or b\"{}\")\n32: \n33: \n34: def afficher(code, obj):\n35:     print(json.dumps(obj, ensure_ascii=False, indent=2))\n36:     return 0 if code == 200 else 1\n37: \n38: \n39: def main():\n40:     a = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n41:     sp = a.add_subparsers(dest=\"cmd\", required=True)\n42:     sp.add_parser(\"etat\")\n43:     sp.add_parser(\"documents\").add_argument(\"dossier\")\n44:     sp.add_parser(\"soumettre\").add_argument(\"dossier\")\n45:     f = sp.add_parser(\"fin\")\n46:     f.add_argument(\"--soumission\", type=int, required=True)\n47:     f.add_argument(\"--score-validation\", type=float)\n48:     f.add_argument(\"--commande\")\n49:     f.add_argument(\"--commentaire\")\n50:     o = a.parse_args()\n51: \n52:     if o.cmd == \"etat\":\n53:         return afficher(*appel(\"GET\", \"/etat\"))\n54:     if o.cmd == \"documents\":\n55:         code, r = appel(\"GET\", \"/documents\")\n56:         if code != 200:\n57:             return afficher(code, r)\n58:         d = Path(o.dossier)\n59:         d.mkdir(parents=True, exist_ok=True)\n60:         for i in r[\"documents\"]:\n61:             _, pdf = appel(\"GET\", f\"/documents/{i}.pdf\", brut=True)\n62:             (d / f\"{i}.pdf\").write_bytes(pdf)\n63:         print(f\"{len(r['documents'])} documents écrits dans {d}\")\n64:         return 0\n65:     if o.cmd == \"soumettre\":\n66:         d = Path(o.dossier)\n67:         _, etat = appel(\"GET\", \"/etat\")\n68:         if etat[\"tache\"] == \"extraction\":\n69:             reponses = {}\n70:             for f in sorted(d.glob(\"*.json\")):\n71:                 try:\n72:                     reponses[f.stem] = json.loads(f.read_text())\n73:                 except json.JSONDecodeError as e:\n74:                     print(f\"{f.name} : JSON illisible ({e})\", file=sys.stderr)\n75:                     return 1\n76:             return afficher(*appel(\"POST\", \"/soumissions\", {\"reponses\": reponses}))\n77:         fichiers = {f\"{d.name}/{p.relative_to(d).as_posix()}\": p.read_text()\n78:                     for p in sorted(d.rglob(\"*.py\")) if \"__pycache__\" not in p.parts}\n79:         return afficher(*appel(\"POST\", \"/soumissions\", {\"fichiers\": fichiers}))\n80:     if o.cmd == \"fin\":\n81:         return afficher(*appel(\"POST\", \"/fin\", {\"soumission_finale\": o.soumission,\n82:                                                 \"score_validation\": o.score_validation,\n83:                                                 \"commande\": o.commande, \"commentaire\": o.commentaire}))\n84: \n85: \n86: if __name__ == \"__main__\":\n87:     sys.exit(main())\n\n(End of file - total 87 lines)\n</content>","metadata":{"preview":"\"\"\"Client de l'API de soumission du banc (bibliothèque standard seulement).\n\nAdresse : variable d'environnement BANC_API (par défaut http://127.0.0.1:8765).\n\n    python soumettre.py etat\n    python soumettre.py documents DOSSIER        télécharge les PDF du test caché dans DOSSIER\n    python soumettre.py soumettre DOSSIER        extraction : un fichier <id>.json par document\n                                                 jouet : le dossier du paquet Python\n    python soumettre.py fin --soumission N [--score-validation X] [--commande \"...\"]\n\"\"\"\nimport argparse\nimport json\nimport os\nimport sys\nimport urllib.error\nimport urllib.request\nfrom pathlib import Path\n\nAPI = os.environ.get(\"BANC_API\", \"http://127.0.0.1:8765\").rstrip(\"/\")\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/travail/soumettre.py","text":"\"\"\"Client de l'API de soumission du banc (bibliothèque standard seulement).\n\nAdresse : variable d'environnement BANC_API (par défaut http://127.0.0.1:8765).\n\n    python soumettre.py etat\n    python soumettre.py documents DOSSIER        télécharge les PDF du test caché dans DOSSIER\n    python soumettre.py soumettre DOSSIER        extraction : un fichier <id>.json par document\n                                                 jouet : le dossier du paquet Python\n    python soumettre.py fin --soumission N [--score-validation X] [--commande \"...\"]\n\"\"\"\nimport argparse\nimport json\nimport os\nimport sys\nimport urllib.error\nimport urllib.request\nfrom pathlib import Path\n\nAPI = os.environ.get(\"BANC_API\", \"http://127.0.0.1:8765\").rstrip(\"/\")\n\n\ndef appel(methode, chemin, corps=None, brut=False):\n    donnees = None if corps is None else json.dumps(corps, ensure_ascii=False).encode()\n    req = urllib.request.Request(API + chemin, data=donnees, method=methode,\n                                 headers={\"Content-Type\": \"application/json\"})\n    try:\n        with urllib.request.urlopen(req, timeout=300) as r:\n            contenu = r.read()\n            return r.status, contenu if brut else json.loads(contenu)\n    except urllib.error.HTTPError as e:\n        return e.code, json.loads(e.read() or b\"{}\")\n\n\ndef afficher(code, obj):\n    print(json.dumps(obj, ensure_ascii=False, indent=2))\n    return 0 if code == 200 else 1\n\n\ndef main():\n    a = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    sp = a.add_subparsers(dest=\"cmd\", required=True)\n    sp.add_parser(\"etat\")\n    sp.add_parser(\"documents\").add_argument(\"dossier\")\n    sp.add_parser(\"soumettre\").add_argument(\"dossier\")\n    f = sp.add_parser(\"fin\")\n    f.add_argument(\"--soumission\", type=int, required=True)\n    f.add_argument(\"--score-validation\", type=float)\n    f.add_argument(\"--commande\")\n    f.add_argument(\"--commentaire\")\n    o = a.parse_args()\n\n    if o.cmd == \"etat\":\n        return afficher(*appel(\"GET\", \"/etat\"))\n    if o.cmd == \"documents\":\n        code, r = appel(\"GET\", \"/documents\")\n        if code != 200:\n            return afficher(code, r)\n        d = Path(o.dossier)\n        d.mkdir(parents=True, exist_ok=True)\n        for i in r[\"documents\"]:\n            _, pdf = appel(\"GET\", f\"/documents/{i}.pdf\", brut=True)\n            (d / f\"{i}.pdf\").write_bytes(pdf)\n        print(f\"{len(r['documents'])} documents écrits dans {d}\")\n        return 0\n    if o.cmd == \"soumettre\":\n        d = Path(o.dossier)\n        _, etat = appel(\"GET\", \"/etat\")\n        if etat[\"tache\"] == \"extraction\":\n            reponses = {}\n            for f in sorted(d.glob(\"*.json\")):\n                try:\n                    reponses[f.stem] = json.loads(f.read_text())\n                except json.JSONDecodeError as e:\n                    print(f\"{f.name} : JSON illisible ({e})\", file=sys.stderr)\n                    return 1\n            return afficher(*appel(\"POST\", \"/soumissions\", {\"reponses\": reponses}))\n        fichiers = {f\"{d.name}/{p.relative_to(d).as_posix()}\": p.read_text()\n                    for p in sorted(d.rglob(\"*.py\")) if \"__pycache__\" not in p.parts}\n        return afficher(*appel(\"POST\", \"/soumissions\", {\"fichiers\": fichiers}))\n    if o.cmd == \"fin\":\n        return afficher(*appel(\"POST\", \"/fin\", {\"soumission_finale\": o.soumission,\n                                                \"score_validation\": o.score_validation,\n                                                \"commande\": o.commande, \"commentaire\": o.commentaire}))\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())","lineStart":1,"lineEnd":87,"totalLines":87,"truncated":false}},"title":"travail/soumettre.py","time":{"start":1795122711204,"end":1795122711210}},"id":"prt_1f5a6caa0001Fk8URYeu6YKkqJ","sessionID":"ses_e0a594e59ffec0m5MQYGM0VOQF","messageID":"msg_1f5a6c4a9001QNy12pmgnS5Br3"}}
