ut 1200 .venv/bin/python work/date_audit.py > work/date_out.txt 2>work/date_err.txt; tail -2 work/date_err.txt; wc -l work/date_out.txt\n.venv/bin/python - <<'EOF'\nimport json,glob,os,sys\nsys.path.insert(0,'workflow')\nfrom consolidation import norm,norm_date\nprod={}\nfor f in glob.glob('work/prod_test2/*.json'):\n    for it in json.load(open(f))['interventions']: prod[norm(it['reference_rapport'])]=it\nfor line in open('work/date_out.txt'):\n    i=line.find(' '); name=line[:i]; a=json.loads(line[i+1:])\n    if a.get('error'): print('ERR',name); continue\n    ref=json.load(open(f'work/test_pieces/{name}.json')).get('intervention',{}).get('reference_rapport'); p=prod.get(norm(ref))\n    di=norm_date(a.get('date_intervention')); dv=norm_date(a.get('date_validation'))\n    if di!=p.get('date_intervention') or dv!=p.get('date_validation'):\n        print('DIFF',name,ref,'prod',p.get('date_intervention'),p.get('date_validation'),'audit',di,dv,'|',a.get('preuve_validation','')[:100])\nEOF","time":{"start":1795500508351,"end":1795500636646}},"id":"prt_20c2b799c001zP2W017iyOQeVy","sessionID":"ses_df4027bf4fferxSUxHfY0Zqzpi","messageID":"msg_20c2b42800014nP0WTQtxHOAE2"}}
