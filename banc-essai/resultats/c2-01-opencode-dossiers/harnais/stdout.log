rt_reference') or '')\n    nz=a.get('normalise') or {}\n    if ref not in outs:\n        print('NOOUT',os.path.basename(f),ref); continue\n    o=outs[ref]; diffs=[]\n    for k in fields:\n        av=nz.get(k)\n        if k in ('statut',): av=status_norm(av) if av else None\n        if k in ('date_intervention','date_validation'): av=norm_date(av)\n        if k in ('volume_dose_ml','volume_nominal_ml','tolerance_ml','debit_ml_min','pression_bar'): av=num(av)\n        if not eq(k,av,o.get(k)):\n            diffs.append((k,o.get(k),av,nz.get(k)))\n    if diffs:\n        print('DIFF',os.path.basename(f),ref)\n        for d in diffs: print('   ',d)\nEOF","time":{"start":1795498660809,"end":1795498660831}},"id":"prt_20c0f4cf2001FdxLEr1QFNXlwE","sessionID":"ses_df4027bf4fferxSUxHfY0Zqzpi","messageID":"msg_20c0f2021001gT2KhgRCpgQUWB"}}
