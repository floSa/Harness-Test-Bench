'white'); y=0\nfor im in imgs: out.paste(im,(0,y)); y+=im.height\nout.save('work/visas.png'); print(out.size)\nEOF","time":{"start":1795498679720,"end":1795498680003}},"id":"prt_20c0f9afa001Pxr4n75jI5PFPr","sessionID":"ses_df4027bf4fferxSUxHfY0Zqzpi","messageID":"msg_20c0f76d7001BNAgOQIQOsx46I"}}
