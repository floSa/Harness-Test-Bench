({('TA842267', 'TA842267'): 5})\ndos-011 Counter({('LU941357', '1U941357'): 3, (None, None): 1, ('LU941340', '1U941340'): 1})\ndos-012 Counter({('HE208694', 'HE208694'): 4})\ndos-018 Counter({('OS-2021-34059', '05202134059'): 5})\ndos-021 Counter({('TO/20/1220', 'T0201220'): 5, ('TO/20/1239', 'T0201239'): 1})\ndos-022 Counter({('HE-2020-31873', 'HE202031873'): 5})\ndos-025 Counter({('LO-2021-49570', '10202149570'): 4})\n","exit":0,"truncated":false},"title":"cd /travail && .venv/bin/python - <<'EOF'\nimport json,glob,os,sys\nfrom collections import Counter\nsys.path.insert(0,'work')\nfrom consolidate import canon_serial\nfor ds in sorted({os.path.basename(f).split('__')[0] for f in glob.glob('work/test_pieces/*.json')}):\n    c=Counter()\n    for f in glob.glob(f'work/test_pieces/{ds}__*.json'):\n        d=json.load(open(f))\n        if d.get('type')=='report':\n            s=(d.get('equipment') or {}).get('numero_serie')\n            c[(s,canon_serial(s))]+=1\n    print(ds,c)\nEOF","time":{"start":1795498890927,"end":1795498890949}},"id":"prt_20c12d4ce001doMM6Cx2wfkmLa","sessionID":"ses_df4027bf4fferxSUxHfY0Zqzpi","messageID":"msg_20c126829001I2HLm5P9sfvNCL"}}
