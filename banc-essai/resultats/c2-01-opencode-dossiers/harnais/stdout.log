{"type":"tool_use","timestamp":1795497497155,"sessionID":"ses_df4027bf4fferxSUxHfY0Zqzpi","part":{"type":"tool","tool":"bash","callID":"chatcmpl-tool-b87cc57a261fcc6e","state":{"status":"completed","input":{"command":"cat /travail/soumettre.py 2>/dev/null | head -80; echo ---; ls /travail/fourni/reponses"},"output":"\"\"\"Client de l'API de soumission du banc (bibliothèque standard seulement).\n\nAdresse : variable d'environnement BANC_API (par défaut http://127.0.0.1:8765).\n\n    python3 soumettre.py etat\n    python3 soumettre.py documents DOSSIER        télécharge les PDF du test caché dans DOSSIER\n                                                 (dossiers : un sous-dossier par dossier)\n    python3 soumettre.py soumettre DOSSIER        extraction : un fichier <id>.json par document\n                                                 dossiers : un fichier <dossier>.json par dossier\n                                                 jouet : le dossier du paquet Python\n    python3 soumettre.py fin --soumission N [--score-validation X] [--commande \"...\"]\n\"\"\"\nimport argparse\nimport json\nimport os\nimport sys\nimport urllib.error\nimport urllib.request\nfrom pathlib import Path\n\nAPI = os.environ.get(\"BANC_API\", \"http://127.0.0.1:8765\").rstrip(\"/\")\n\n\ndef appel(methode, chemin, corps=None, brut=False):\n    donnees = None if corps is None else json.dumps(corps, ensure_ascii=False).encode()\n    req = urllib.request.Request(API + chemin, data=donnees, method=methode,\n                                 headers={\"Content-Type\": \"application/json\"})\n    try:\n        with urllib.request.urlopen(req, timeout=300) as r:\n            contenu = r.read()\n            return r.status, contenu if brut else json.loads(contenu)\n    except urllib.error.HTTPError as e:\n        return e.code, json.loads(e.read() or b\"{}\")\n\n\ndef afficher(code, obj):\n    print(json.dumps(obj, ensure_ascii=False, indent=2))\n    return 0 if code == 200 else 1\n\n\ndef main():\n    a = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    sp = a.add_subparsers(dest=\"cmd\", required=True)\n    sp.add_parser(\"etat\")\n    sp.add_parser(\"documents\").add_argument(\"dossier\")\n    sp.add_parser(\"soumettre\").add_argument(\"dossier\")\n    f = sp.add_parser(\"fin\")\n    f.add_argument(\"--soumission\", type=int, required=True)\n    f.add_argument(\"--score-validation\", type=float)\n    f.add_argument(\"--commande\")\n    f.add_argument(\"--commentaire\")\n    o = a.parse_args()\n\n    if o.cmd == \"etat\":\n        return afficher(*appel(\"GET\", \"/etat\"))\n    if o.cmd == \"documents\":\n        d = Path(o.dossier)\n        _, etat = appel(\"GET\", \"/etat\")\n        if etat[\"tache\"] == \"dossiers\":\n            code, r = appel(\"GET\", \"/dossiers\")\n            if code != 200:\n                return afficher(code, r)\n            for i, pieces in r[\"dossiers\"].items():\n                (d / i).mkdir(parents=True, exist_ok=True)\n                for p in pieces:\n                    _, pdf = appel(\"GET\", f\"/dossiers/{i}/{p}\", brut=True)\n                    (d / i / p).write_bytes(pdf)\n            print(f\"{len(r['dossiers'])} dossiers écrits dans {d}\")\n            return 0\n        code, r = appel(\"GET\", \"/documents\")\n        if code != 200:\n            return afficher(code, r)\n        d.mkdir(parents=True, exist_ok=True)\n        for i in r[\"documents\"]:\n            _, pdf = appel(\"GET\", f\"/documents/{i}.pdf\", brut=True)\n            (d / f\"{i}.pdf\").write_bytes(pdf)\n        print(f\"{len(r['documents'])} documents écrits dans {d}\")\n        return 0\n    if o.cmd == \"soumettre\":\n        d = Path(o.dossier)\n---\ndos-007.json\ndos-009.json\ndos-010.json\ndos-013.json\ndos-015.json\ndos-017.json\n","metadata":{"output":"\"\"\"Client de l'API de soumission du banc (bibliothèque standard seulement).\n\nAdresse : variable d'environnement BANC_API (par défaut http://127.0.0.1:8765).\n\n    python3 soumettre.py etat\n    python3 soumettre.py documents DOSSIER        télécharge les PDF du test caché dans DOSSIER\n                                                 (dossiers : un sous-dossier par dossier)\n    python3 soumettre.py soumettre DOSSIER        extraction : un fichier <id>.json par document\n                                                 dossiers : un fichier <dossier>.json par dossier\n                                                 jouet : le dossier du paquet Python\n    python3 soumettre.py fin --soumission N [--score-validation X] [--commande \"...\"]\n\"\"\"\nimport argparse\nimport json\nimport os\nimport sys\nimport urllib.error\nimport urllib.request\nfrom pathlib import Path\n\nAPI = os.environ.get(\"BANC_API\", \"http://127.0.0.1:8765\").rstrip(\"/\")\n\n\ndef appel(methode, chemin, corps=None, brut=False):\n    donnees = None if corps is None else json.dumps(corps, ensure_ascii=False).encode()\n    req = urllib.request.Request(API + chemin, data=donnees, method=methode,\n                                 headers={\"Content-Type\": \"application/json\"})\n    try:\n        with urllib.request.urlopen(req, timeout=300) as r:\n            contenu = r.read()\n            return r.status, contenu if brut else json.loads(contenu)\n    except urllib.error.HTTPError as e:\n        return e.code, json.loads(e.read() or b\"{}\")\n\n\ndef afficher(code, obj):\n    print(json.dumps(obj, ensure_ascii=False, indent=2))\n    return 0 if code == 200 else 1\n\n\ndef main():\n    a = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    sp = a.add_subparsers(dest=\"cmd\", required=True)\n    sp.add_parser(\"etat\")\n    sp.add_parser(\"documents\").add_argument(\"dossier\")\n    sp.add_parser(\"soumettre\").add_argument(\"dossier\")\n    f = sp.add_parser(\"fin\")\n    f.add_argument(\"--soumission\", type=int, required=True)\n    f.add_argument(\"--score-validation\", type=float)\n    f.add_argument(\"--commande\")\n    f.add_argument(\"--commentaire\")\n    o = a.parse_args()\n\n    if o.cmd == \"etat\":\n        return afficher(*appel(\"GET\", \"/etat\"))\n    if o.cmd == \"documents\":\n        d = Path(o.dossier)\n        _, etat = appel(\"GET\", \"/etat\")\n        if etat[\"tache\"] == \"dossiers\":\n            code, r = appel(\"GET\", \"/dossiers\")\n            if code != 200:\n                return afficher(code, r)\n            for i, pieces in r[\"dossiers\"].items():\n                (d / i).mkdir(parents=True, exist_ok=True)\n                for p in pieces:\n                    _, pdf = appel(\"GET\", f\"/dossiers/{i}/{p}\", brut=True)\n                    (d / i / p).write_bytes(pdf)\n            print(f\"{len(r['dossiers'])} dossiers écrits dans {d}\")\n            return 0\n        code, r = appel(\"GET\", \"/documents\")\n        if code != 200:\n            return afficher(code, r)\n        d.mkdir(parents=True, exist_ok=True)\n        for i in r[\"documents\"]:\n            _, pdf = appel(\"GET\", f\"/documents/{i}.pdf\", brut=True)\n            (d / f\"{i}.pdf\").write_bytes(pdf)\n        print(f\"{len(r['documents'])} documents écrits dans {d}\")\n        return 0\n    if o.cmd == \"soumettre\":\n        d = Path(o.dossier)\n---\ndos-007.json\ndos-009.json\ndos-010.json\ndos-013.json\ndos-015.json\ndos-017.json\n","exit":0,"truncated":false},"title":"cat /travail/soumettre.py 2>/dev/null | head -80; echo ---; ls /travail/fourni/reponses","time":{"start":1795497497136,"end":1795497497146}},"id":"prt_20bfd91c6001bnlowAJfd4V24D","sessionID":"ses_df4027bf4fferxSUxHfY0Zqzpi","messageID":"msg_20bfd8da5001AfBNFhe9wgiVCw"}}
