nformation\\s+complémentaire|pour\\s+mémoire|à\\s+noter)[^\\n]{0,30}?(?:technicien\\s+responsable|lead\\s+engineer|lead\\s+technician)\\s*[:=]\\s*([A-ZÀ-Ý][^\\n,;]{1,60})\",\n]\n\n\ndef _first_match(patterns, text):\n    import re\n    for pat in patterns:\n        for m in re.finditer(pat, text, re.I):\n            yield m.group(1), m.group(2) if m.lastindex and m.lastindex >= 2 else \"\"\n\n\ndef _apply_fallbacks(obj: dict, text: str) -> dict:\n    from consolidation import parse_number\n    it = obj.get(\"intervention\") or {}\n    if obj.get(\"type\") != \"report\":\n        return obj\n\n    if it.get(\"debit_ml_min\") is None:\n        for val, unit in _first_match(_DEBIT_PATTERNS, text):\n            n = parse_number(val, \"debit_ml_min\")\n            if n is None:\n                continue\n            # unit detected separately (parse_number only sees the number)\n            u = (unit or \"\").lower()\n            if u == \"l/h\":\n                n = n * 1000.0 / 60.0\n            elif u == \"l/min\":\n                n = n * 1000.0\n            elif u in (\"ml/s\", \"cl/min\"[:0] + \"ml/s\"):\n                n = n * 60.0\n            elif u == \"cl/min\":\n                n = n * 10.0\n            elif u == \"m3/h\":\n                n = n * 1000.0 / 60.0 * 1000.0\n            it[\"debit_ml_min\"] = round(n, 4) if n is not None else None\n            break\n\n    if it.get(\"pression_bar\") is None:\n        for val, unit in _first_match(_PRESSURE_PATTERNS, text):\n            n = parse_number(val, \"pression_bar\")\n            if n is None:\n                continue\n            u = (unit or \"\").lower()\n            if u == \"kpa\":\n                n = n / 100.0\n            elif u == \"mbar\":\n                n = n / 1000.0\n            elif u == \"psi\":\n                n = n * 0.0689475729\n            it[\"pression_bar\"] = round(n, 6) if n is not None else None\n            break\n\n    if not it.get(\"technicien\"):\n        for val, _ in _first_match(_TECH_PATTERNS, text):\n            v = val.strip().rstrip(\".\")\n            if v:\n                it[\"technicien\"] = v\n                break\n\n    obj[\"intervention\"] = it\n    return obj\n'''\ns=s.replace('\\n\\ndef _call(', insert+'\\n\\ndef _call(')\ns=s.replace('''            return _parse_json(_call([{\"role\": \"user\", \"content\": content}]))\n        except Exception as e:  # network, JSON, empty content''','''            obj = _parse_json(_call([{\"role\": \"user\", \"content\": content}]))\n            return _apply_fallbacks(obj, \"\\\\n\".join(texts))\n        except Exception as e:  # network, JSON, empty content''')\ns=s.replace('''            return _parse_json(_call([{\"role\": \"user\", \"content\": text_content}]))\n        except Exception as e:''','''            obj = _parse_json(_call([{\"role\": \"user\", \"content\": text_content}]))\n            return _apply_fallbacks(obj, \"\\\\n\".join(texts))\n        except Exception as e:''')\nopen(p,'w').write(s)\nprint('patched')\nEOF\n.venv/bin/python -c \"import sys; sys.path.insert(0,'workflow'); import extraction; print('import ok')\""},"output":"patched\nimport ok\n","metadata":{"output":"patched\nimport ok\n","exit":0,"truncated":false},"title":"cd /travail && .venv/bin/python - <<'EOF'\np='workflow/extraction.py'\ns=open(p).read()\ninsert=r'''\n\n_DEBIT_PATTERNS = [\n    r\"(?:l['’]équipement|la machine|le doseur|l['’]installation|il|elle)\\s+débite\\s+alors\\s+([\\d\\s.,'’]+)\\s*(l/h|l/min|ml/s|ml/min|cl/min|m3/h)\",\n    r\"(?:the\\s+)?(?:equipment|machine|pump|filler)\\s+then\\s+deliver(?:s|ing)?\\s+([\\d.,'’]+)\\s*(l/h|l/min|ml/s|ml/min|cl/min|m3/h)\",\n    r\"(?:débit|débit volumique|cadence(?:\\s+volumique)?)[^\\n]{0,60}?après\\s+réglage[^\\n]{0,30}?[:=]?\\s*([\\d\\s.,'’]+)\\s*(l/h|l/min|ml/s|ml/min|cl/min|m3/h)\",\n    r\"(?:flow\\s+rate|throughput|delivery\\s+rate)[^\\n]{0,40}?as\\s+left[^\\n]{0,25}?[:=]?\\s*([\\d.,'’]+)\\s*(l/h|l/min|ml/s|ml/min|cl/min|m3/h)\",\