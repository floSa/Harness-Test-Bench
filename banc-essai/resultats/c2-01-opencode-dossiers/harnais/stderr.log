timestamp=2026-11-24T05:53:56.893Z level=INFO run=2c4c988f message=evaluated permission=bash pattern=".venv/bin/python - <<'EOF' > work/focus_list.txt\nimport json,glob,os\n# find retained refs with missing debit/pressure and map to piece files\nmissing={}\nfor f in glob.glob('work/prod_test2/*.json'):\n    d=json.load(open(f)); ds=os.path.basename(f)[:-5]\n    for it in d['interventions']:\n        if it['debit_ml_min'] is None or it['pression_bar'] is None:\n            missing[it['reference_rapport']]=ds\nfor f in glob.glob('work/test_pieces/*.json'):\n    d=json.load(open(f)); it=d.get('intervention') or {}; ref=it.get('reference_rapport')\n    if ref in missing:\n        ds=os.path.basename(f).split('__')[0]\n        print(f'{ds}__{os.path.basename(f)[:-5].split(\"__\")[1]} test/{ds}/{os.path.basename(f)[:-5].split(\"__\")[1]}.pdf')\nEOF" action.permission=bash action.action=allow action.pattern=*
