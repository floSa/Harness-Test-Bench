timestamp=2026-11-24T05:44:22.844Z level=INFO run=2c4c988f message=evaluated permission=bash pattern=".venv/bin/python - <<'EOF'\nimport json,glob,os\nfor f in sorted(glob.glob('work/prod_test/*.json')):\n    ds=os.path.basename(f); a=json.load(open(f)); b=json.load(open('work/test_out/'+ds))\n    if a!=b:\n        print('DIFF',ds)\n        for k in ['machine','constructeur','numero_serie','site','statut_actuel']:\n            if a.get(k)!=b.get(k): print('  eq',k,b.get(k),'->',a.get(k))\n        ai={i['reference_rapport']:i for i in a['interventions']}; bi={i['reference_rapport']:i for i in b['interventions']}\n        if set(ai)!=set(bi): print('  refs',set(bi),'->',set(ai))\n        for r in set(ai)&set(bi):\n            for k in ai[r]:\n                if ai[r].get(k)!=bi[r].get(k): print('  ',r,k,bi[r].get(k),'->',ai[r].get(k))\nEOF" action.permission=bash action.action=allow action.pattern=*
