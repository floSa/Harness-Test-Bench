{"type":"message","message":{"id":"gen-1795129295-2BYFr7E0j9EGodsZVxJR","role":"assistant","created":1795129303,"content":[{"type":"toolRequest","id":"chatcmpl-tool-9d2e36444d154d64","toolCall":{"status":"success","value":{"name":"shell","arguments":{"command":"cd /travail && cat > work/llm.py <<'EOF'\nimport os, json, urllib.request, urllib.error, time\n\nURL = os.environ['BANC_MODELE_URL'].rstrip('/') + '/v1/chat/completions'\nMODEL = os.environ['BANC_MODELE']\nKEY = os.environ['BANC_CLE_MODELE']\n\ndef chat(messages, max_tokens=4000, json_mode=True, temperature=0):\n    body = {\"model\": MODEL, \"messages\": messages, \"max_tokens\": max_tokens,\n            \"temperature\": temperature}\n    if json_mode: body[\"response_format\"] = {\"type\": \"json_object\"}\n    req = urllib.request.Request(URL, data=json.dumps(body, ensure_ascii=False).encode(),\n        headers={\"Content-Type\":\"application/json\",\"Authorization\":\"Bearer \"+KEY})\n    for attempt in range(4):\n        try:\n            with urllib.request.urlopen(req, timeout=300) as r:\n                d = json.load(r)\n            m = d['choices'][0]['message']\n            return m.get('content')\n        except urllib.error.HTTPError as e:\n            print('HTTP', e.code, e.read()[:300], flush=True); time.sleep(2*(attempt+1))\n        except Exception as e:\n            print('ERR', e, flush=True); time.sleep(2*(attempt+1))\n    return None\nEOF\n.venv/bin/python - <<'EOF'\nimport sys; sys.path.insert(0,'/travail/work')\nfrom llm import chat\nt=open('/travail/work/textes/doc-009.txt').read()\nr=chat([{\"role\":\"system\",\"content\":\"Tu extrais des données de rapports d'intervention. Réponds uniquement en JSON.\"},{\"role\":\"user\",\"content\":t[:6000]+\"\\n\\nExtrais les 15 clés machine, constructeur, numero_serie, site, reference_rapport, date_intervention, date_validation, volume_dose_ml, volume_nominal_ml, tolerance_ml, debit_ml_min, pression_bar, reference_piece, technicien, statut en JSON.\"}], max_tokens=3000)\nprint(r)\nEOF"}}},"_meta":{"goose.toolCall.providerIndex":0,"goose_extension":"developer"}}],"metadata":{"userVisible":true,"agentVisible":true,"inference":{"provider":"openai","requestedModel":"deepseek-v4.1-flash"},"operations":{"llm":{"advertised_tools":["analyze","apps__create_app","apps__delete_app","apps__iterate_app","apps__list_apps","delegate","edit","extensionmanager__list_resources","extensionmanager__manage_extensions","extensionmanager__read_resource","extensionmanager__search_available_extensions","load","load_skill","read_image","shell","tree","write"]}}}}}
