{"type":"message","message":{"id":"gen-1795129218-JMzcxlBCb4YxOPgCrYBT","role":"assistant","created":1795129226,"content":[{"type":"toolRequest","id":"chatcmpl-tool-94c35da0aca2c381","toolCall":{"status":"success","value":{"name":"shell","arguments":{"command":"mkdir -p /travail/work && cd /travail && cat > work/extract_text.py <<'EOF'\nimport pymupdf, glob, os, sys, json, time\nfrom rapidocr_onnxruntime import RapidOCR\nocr = RapidOCR()\nOUT = '/travail/work/textes'\nos.makedirs(OUT, exist_ok=True)\n\ndef ocr_image(doc, xref):\n    pix = pymupdf.Pixmap(doc, xref)\n    if pix.n - pix.alpha >= 4:\n        pix = pymupdf.Pixmap(pymupdf.csRGB, pix)\n    # upscale small images for OCR\n    if pix.width < 700:\n        z = min(3.0, 1000/pix.width)\n        pix = pymupdf.Pixmap(pix, 0) if False else pix\n    png = pix.tobytes('png')\n    res, _ = ocr(png)\n    if not res: return []\n    return [t for _, t, s in res if s > 0.35]\n\ndef process(pdf):\n    doc = pymupdf.open(pdf)\n    out = []\n    for pno, page in enumerate(doc, 1):\n        out.append(f\"\\n\\n===== PAGE {pno} =====\")\n        out.append(page.get_text())\n        infos = page.get_image_info(xrefs=True)\n        for i, info in enumerate(infos):\n            b = info['bbox']\n            lines = ocr_image(doc, info['xref'])\n            if lines:\n                out.append(f\"\\n[IMAGE p{pno} #{i+1} bbox=({b[0]:.0f},{b[1]:.0f},{b[2]:.0f},{b[3]:.0f}) texte OCR:]\")\n                out.append(' | '.join(lines))\n    return '\\n'.join(out)\n\nif __name__ == '__main__':\n    files = sys.argv[1:] or sorted(glob.glob('/travail/fourni/*.pdf'))\n    for p in files:\n        name = os.path.basename(p)[:-4]\n        dest = os.path.join(OUT, name + '.txt')\n        if os.path.exists(dest): continue\n        t0=time.time()\n        txt = process(p)\n        open(dest,'w').write(txt)\n        print(name, len(txt), f'{time.time()-t0:.1f}s', flush=True)\nEOF\ntime .venv/bin/python work/extract_text.py 2>&1 | tail -40"}}},"_meta":{"goose.toolCall.providerIndex":0,"goose_extension":"developer"}}],"metadata":{"userVisible":true,"agentVisible":true,"inference":{"provider":"openai","requestedModel":"deepseek-v4.1-flash"},"operations":{"llm":{"advertised_tools":["analyze","apps__create_app","apps__delete_app","apps__iterate_app","apps__list_apps","delegate","edit","extensionmanager__list_resources","extensionmanager__manage_extensions","extensionmanager__read_resource","extensionmanager__search_available_extensions","load","load_skill","read_image","shell","tree","write"]}}}}}
