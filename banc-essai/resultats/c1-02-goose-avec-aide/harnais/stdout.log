e.get_text())\n        infos = page.get_image_info(xrefs=True)\n        for i, info in enumerate(infos):\n            b = info['bbox']\n            lines = ocr_image(doc, info['xref'])\n            if lines:\n                out.append(f\"\\n[IMAGE p{pno} #{i+1} bbox=({b[0]:.0f},{b[1]:.0f},{b[2]:.0f},{b[3]:.0f}) texte OCR:]\")\n                out.append(' | '.join(lines))\n    return '\\n'.join(out)\n\nif __name__ == '__main__':\n    files = sys.argv[1:] or sorted(glob.glob('/travail/fourni/*.pdf'))\n    for p in files:\n        name = os.path.basename(p)[:-4]\n        dest = os.path.join(OUT, name + '.txt')\n        if os.path.exists(dest): continue\n        t0=time.time()\n        txt = process(p)\n        open(dest,'w').write(txt)\n        print(name, len(txt), f'{time.time()-t0:.1f}s', flush=True)\n====\nimport pymupdf, glob, os, re\n\nSTATUS_LABELS = [\n    ('non_conforme', ['non-conforme','non conforme','noncompliant','non compliant']),\n    ('a_revoir', ['a revoir','à revoir','to be reviewed','reviewed']),\n    ('conforme', ['conforme','compliant']),\n]\n\ndef norm(s):\n    s = s.lower()\n    for a,b in [('à','a'),('é','e'),('è','e'),('ê','e'),('ç','c'),('û','u'),('ô','o')]:\n        s = s.replace(a,b)\n    return re.sub(r'[^a-z0-9]+',' ',s).strip()\n\ndef page_status(page):\n    words = page.get_text('words')\n    drawings = page.get_drawings()\n    boxes = []\n    for dr in drawings:\n        r = dr['rect']\n        if dr['type'] in ('s','f') and 5 <= r.width <= 14 and 5 <= r.height <= 14:\n            # box candidate if it's a rect item or fill\n            items = dr.get('items', [])\n            if any(it[0]=='re' for it in items) or dr['type']=='f':\n                boxes.append((r, dr))\n    # merge boxes with same bbox\n    outs = []\n    for r, dr in boxes:\n        # marks inside\n        marked = False\n        nlines = 0\n        for d2 in drawings:\n            r2 = d2['rect']\n            if abs(r2.x0-r.x0)<1.5 and abs(r2.y0-r.y0)<1.5 and abs(r2.x1-r.x1)<1.5 and abs(r2.y1-r.y1)<1.5:\n                lines = [it for it in d2.get('items',[]) if it[0] in ('l','c')]\n                nlines += len(lines)\n                if d2.get('fill') and d2 is not dr:\n                    marked = True\n        if nlines >= 2:\n            marked = True\n        # label at same y to the right\n        cand = []\n        for w in words:\n            x0,y0,x1,y1,t = w[:5]\n            if abs((y0+y1)/2 - (r.y0+r.y1)/2) < 7 and x0 > r.x1-1 and x0 < r.x1+160:\n                cand.append((x0,t))\n        cand.sort()\n        label = ' '.join(t for _,t in cand)\n        if label:\n            outs.append((round((r.y0+r.y1)/2,1), label, marked))\n    # dedupe by (y,label)\n    seen=set(); res=[]\n    for y,label,m in outs:\n        key=(y,norm(label))\n        if key in seen: continue\n        seen.add(key); res.append((y,label,m))\n    return res\n\nif __name__ == '__main__':\n    for p in sorted(glob.glob('/travail/fourni/*.pdf')+glob.glob('/travail/test/*.pdf')):\n        d = pymupdf.open(p)\n        rows=[]\n        for pno,page in enumerate(d,1):\n            for y,label,m in page_status(page):\n                if m: rows.append((pno,label))\n        if rows:\n            print(os.path.basename(p), rows)\n====\n35\n35","annotations":{"priority":0.0}}],"structuredContent":{"stdout":"import pymupdf, glob, os, sys, json, time\nfrom rapidocr_onnxruntime import RapidOCR\nocr = RapidOCR()\nOUT = '/travail/work/textes'\nos.makedirs(OUT, exist_ok=True)\n\ndef ocr_image(doc, xref):\n    pix = pymupdf.Pixmap(doc, xref)\n    if pix.n - pix.alpha >= 4:\n        pix = pymupdf.Pixmap(pymupdf.csRGB, pix)\n    # upscale small images for OCR\n    if pix.width < 700:\n        z = min(3.0, 1000/pix.width)\n        pix = pymupdf.Pixmap(pix, 0) if False else pix\n    png = pix.tobytes('png')\n    res, _ = ocr(png)\n    if not res: return []\n    return [t for _, t, s in res if s > 0.35]\n\ndef process(pdf):\n    doc = pymupdf.open(pdf)\n    out = []\n    for pno, page in enumerate(doc, 1):\n        out.append(f\"\\n\\n===== PAGE {pno} =====\")\n        out.append(page.get_text())\n        infos = page.get_image_info(xrefs=True)\n        for i, info in enumerate(infos):\n            b = info['bbox']\n            lines = ocr_image(doc, info['xref'])\n            if lines:\n                out.append(f\"\\n[IMAGE p{pno} #{i+1} bbox=({b[0]:.0f},{b[1]:.0f},{b[2]:.0f},{b[3]:.0f}) texte OCR:]\")\n                out.append(' | '.join(lines))\n    return '\\n'.join(out)\n\nif __name__ == '__main__':\n    files = sys.argv[1:] or sorted(glob.glob('/travail/fourni/*.pdf'))\n    for p in files:\n        name = os.path.basename(p)[:-4]\n        dest = os.path.join(OUT, name + '.txt')\n        if os.path.exists(dest): continue\n        t0=time.time()\n        txt = process(p)\n        open(dest,'w').write(txt)\n        print(name, len(txt), f'{time.time()-t0:.1f}s', flush=True)\n====\nimport pymupdf, glob, os, re\n\nSTATUS_LABELS = [\n    ('non_conforme', ['non-conforme','non conforme','noncompliant','non compliant']),\n    ('a_revoir', ['a revoir','à revoir','to be reviewed','reviewed']),\n    ('conforme', ['conforme','compliant']),\n]\n\ndef norm(s):\n    s = s.lower()\n    for a,b in [('à','a'),('é','e'),('è','e'),('ê','e'),('ç','c'),('û','u'),('ô','o')]:\n        s = s.replace(a,b)\n    return re.sub(r'[^a-z0-9]+',' ',s).strip()\n\ndef page_status(page):\n    words = page.get_text('words')\n    drawings = page.get_drawings()\n    boxes = []\n    for dr in drawings:\n        r = dr['rect']\n        if dr['type'] in ('s','f') and 5 <= r.width <= 14 and 5 <= r.height <= 14:\n            # box candidate if it's a rect item or fill\n            items = dr.get('items', [])\n            if any(it[0]=='re' for it in items) or dr['type']=='f':\n                boxes.append((r, dr))\n    # merge boxes with same bbox\n    outs = []\n    for r, dr in boxes:\n        # marks inside\n        marked = False\n        nlines = 0\n        for d2 in drawings:\n            r2 = d2['rect']\n            if abs(r2.x0-r.x0)<1.5 and abs(r2.y0-r.y0)<1.5 and abs(r2.x1-r.x1)<1.5 and abs(r2.y1-r.y1)<1.5:\n                lines = [it for it in d2.get('items',[]) if it[0] in ('l','c')]\n                nlines += len(lines)\n                if d2.get('fill') and d2 is not dr:\n                    marked = True\n        if nlines >= 2:\n            marked = True\n        # label at same y to the right\n        cand = []\n        for w in words:\n            x0,y0,x1,y1,t = w[:5]\n            if abs((y0+y1)/2 - (r.y0+r.y1)/2) < 7 and x0 > r.x1-1 and x0 < r.x1+160:\n                cand.append((x0,t))\n        cand.sort()\n        label = ' '.join(t for _,t in cand)\n        if label:\n            outs.append((round((r.y0+r.y1)/2,1), label, marked))\n    # dedupe by (y,label)\n    seen=set(); res=[]\n    for y,label,m in outs:\n        key=(y,norm(label))\n        if key in seen: continue\n        seen.add(key); res.append((y,label,m))\n    return res\n\nif __name__ == '__main__':\n    for p in sorted(glob.glob('/travail/fourni/*.pdf')+glob.glob('/travail/test/*.pdf')):\n        d = pymupdf.open(p)\n        rows=[]\n        for pno,page in enumerate(d,1):\n            for y,label,m in page_status(page):\n                if m: rows.append((pno,label))\n        if rows:\n            print(os.path.basename(p), rows)\n====\n35\n35","stderr":"","exit_code":0},"isError":false}}}],"metadata":{"userVisible":true,"agentVisible":true}}}
