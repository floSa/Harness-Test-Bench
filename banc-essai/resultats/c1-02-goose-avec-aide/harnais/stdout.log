{"type":"message","message":{"id":"msg_5a5981e1-90d3-4822-bf2b-880db2694388","role":"user","created":1795130847,"content":[{"type":"toolResponse","id":"chatcmpl-tool-a4d154832f251134","toolResult":{"status":"success","value":{"resultType":"complete","content":[{"type":"text","text":"import json, glob, os, sys, re, unicodedata\nKEYS = [\"machine\",\"constructeur\",\"numero_serie\",\"site\",\"reference_rapport\",\"date_intervention\",\"date_validation\",\"volume_dose_ml\",\"volume_nominal_ml\",\"tolerance_ml\",\"debit_ml_min\",\"pression_bar\",\"reference_piece\",\"technicien\",\"statut\"]\ndef norm(s):\n    s = unicodedata.normalize('NFKD', str(s)).encode('ascii','ignore').decode().lower()\n    return re.sub(r'[^a-z0-9]+',' ',s).strip()\ndef eq(k, a, b):\n    if a is None or b is None: return a is None and b is None\n    if k in ('volume_dose_ml','volume_nominal_ml','tolerance_ml','debit_ml_min','pression_bar'):\n        try: return abs(float(a)-float(b))<=0.01\n        except: return False\n    if k.startswith('date'):\n        return str(a)==str(b)\n    if k=='statut':\n        return norm(a)==norm(b)\n    return norm(a)==norm(b)\npreds_dir = sys.argv[1] if len(sys.argv)>1 else '/travail/work/preds'\ntot=0; good=0; per={k:[0,0] for k in KEYS}; errors={k:[] for k in KEYS}\nfor p in sorted(glob.glob('/travail/fourni/reponses/*.json')):\n    doc=os.path.basename(p)[:-5]\n    exp=json.load(open(p)); pred=json.load(open(f'{preds_dir}/{doc}.json'))\n    for k in KEYS:\n        tot+=1; per[k][1]+=1\n        ok=eq(k, pred.get(k), exp.get(k))\n        if ok: good+=1; per[k][0]+=1\n        else: errors[k].append((doc, exp.get(k), pred.get(k)))\nprint(f'SCORE {good}/{tot} = {good/tot:.4f}')\nfor k in KEYS:\n    print(f'{k:20s} {per[k][0]:2d}/{per[k][1]:2d}')\nprint()\nfor k in KEYS:\n    if errors[k]:\n        print('###',k)\n        for e in errors[k]: print('  ',e)","annotations":{"priority":0.0}}],"structuredContent":{"stdout":"import json, glob, os, sys, re, unicodedata\nKEYS = [\"machine\",\"constructeur\",\"numero_serie\",\"site\",\"reference_rapport\",\"date_intervention\",\"date_validation\",\"volume_dose_ml\",\"volume_nominal_ml\",\"tolerance_ml\",\"debit_ml_min\",\"pression_bar\",\"reference_piece\",\"technicien\",\"statut\"]\ndef norm(s):\n    s = unicodedata.normalize('NFKD', str(s)).encode('ascii','ignore').decode().lower()\n    return re.sub(r'[^a-z0-9]+',' ',s).strip()\ndef eq(k, a, b):\n    if a is None or b is None: return a is None and b is None\n    if k in ('volume_dose_ml','volume_nominal_ml','tolerance_ml','debit_ml_min','pression_bar'):\n        try: return abs(float(a)-float(b))<=0.01\n        except: return False\n    if k.startswith('date'):\n        return str(a)==str(b)\n    if k=='statut':\n        return norm(a)==norm(b)\n    return norm(a)==norm(b)\npreds_dir = sys.argv[1] if len(sys.argv)>1 else '/travail/work/preds'\ntot=0; good=0; per={k:[0,0] for k in KEYS}; errors={k:[] for k in KEYS}\nfor p in sorted(glob.glob('/travail/fourni/reponses/*.json')):\n    doc=os.path.basename(p)[:-5]\n    exp=json.load(open(p)); pred=json.load(open(f'{preds_dir}/{doc}.json'))\n    for k in KEYS:\n        tot+=1; per[k][1]+=1\n        ok=eq(k, pred.get(k), exp.get(k))\n        if ok: good+=1; per[k][0]+=1\n        else: errors[k].append((doc, exp.get(k), pred.get(k)))\nprint(f'SCORE {good}/{tot} = {good/tot:.4f}')\nfor k in KEYS:\n    print(f'{k:20s} {per[k][0]:2d}/{per[k][1]:2d}')\nprint()\nfor k in KEYS:\n    if errors[k]:\n        print('###',k)\n        for e in errors[k]: print('  ',e)","stderr":"","exit_code":0},"isError":false}}}],"metadata":{"userVisible":true,"agentVisible":true}}}
