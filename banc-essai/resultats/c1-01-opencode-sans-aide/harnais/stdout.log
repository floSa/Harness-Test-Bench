 old in s\ns=s.replace(old,new); open(p,'w').write(s); print('ok')\nEOF\n# apply postprocess to existing outputs to verify without re-calling\n.venv/bin/python - <<'EOF'\nimport sys,json,glob,os,pymupdf,re,unicodedata\nsys.path.insert(0,'.'); import extraire as E\ndef norm(s): return E.norm(s)\nkeys=E.KEYS; ok=tot=0\nfor f in sorted(glob.glob('/tmp/sortie_fourni/*.json')):\n stem=os.path.basename(f)[:-5]; pred=json.load(open(f)); text=\"\\n\".join(p.get_text() for p in pymupdf.open('fourni/'+stem+'.pdf'))\n pred=E.text_postprocess(text,pred); ans=json.load(open('fourni/reponses/'+stem+'.json'))\n bad=[]\n for k in keys:\n  a=ans[k]; p=pred.get(k); good=False\n  if a is None: good=p is None\n  elif isinstance(a,(int,float)) and not isinstance(a,bool):\n   try: good=abs(float(p)-a)<=.011\n   except: good=False\n  elif k.startswith('date'): good=p==a\n  else: good=norm(p)==norm(a)\n  if good: ok+=1\n  else: bad.append((k,a,p))\n  tot+=1\n if bad: print(stem,bad)\nprint('TOTAL',ok,tot,ok/tot)\nEOF"},"output":"ok\ndoc-002 [('site', 'Usine de Cholet', 'Établissement Usine de Cholet')]\ndoc-021 [('site', 'Wexford Facility', 'Site Wexford Facility')]\ndoc-041 [('site', 'Tralee Facility', 'Site Tralee Facility')]\ndoc-042 [('site', 'Plateforme de Guingamp', 'Site Plateforme de Guingamp')]\ndoc-045 [('site', 'Dundee Site', 'Location Dundee Site')]\ndoc-051 [('constructeur', 'Ostiovan', 'Ostiavan')]\nTOTAL 519 525 0.9885714285714285\n","metadata":{"output":"ok\ndoc-002 [('site', 'Usine de Cholet', 'Établissement Usine de Cholet')]\ndoc-021 [('site', 'Wexford Facility', 'Site Wexford Facility')]\ndoc-041 [('site', 'Tralee Facility', 'Site Tralee Facility')]\ndoc-042 [('site', 'Plateforme de Guingamp', 'Site Plateforme de Guingamp')]\ndoc-045 [('site', 'Dundee Site', 'Location Dundee Site')]\ndoc-051 [('constructeur', 'Ostiovan', 'Ostiavan')]\nTOTAL 519 525 0.9885714285714285\n","exit":0,"truncated":false},"title":"cd /travail && .venv/bin/python - <<'EOF'\np='extraire.py'; s=open(p).read()\nold='''        if re.search(r\"^(line|ligne|pompe|doseuse|remplisseuse|pipette|filler|pump|machine|installation)\\\\b\", ns):\n            pred[\"site\"] = None\n        else:\n            for m in re.finditer(r\"\\\\b(?:Usine|Établissement|Etablissement|Site|Plateforme|Centre|Plant|Facility|Works|Location)\\\\s+(?:(?:de|des|du)\\\\s+|d['’])?[A-ZÀ-Ý][^\\\\n,.;:]{1,60}\", t):\n                full = m.group(0).strip(\" .,:;\")\n                if norm(site) and norm(site) in norm(full) and norm(full) != norm(site):\n                    pred[\"site\"] = full\n                    break\n'''\nnew='''        if re.search(r\"^(line|ligne|pompe|doseuse|remplisseuse|pipette|filler|pump|machine|installation)\\\\b\", ns):\n            pred[\"site\"] = None\n        elif not (re.match(r\"^(usine|etablissement|plateforme|centre|site)\\\\b\", ns)\n                  or re.search(r\"\\\\b(facility|plant|works|site)$\", ns)):\n            for m in re.finditer(r\"\\\\b(?:Usine|Établissement|Etablissement|Plateforme|Centre)\\\\s+(?:(?:de|des|du)\\\\s+|d['’])?[A-ZÀ-Ý][^\\\\n,.;:]{1,60}\", t):\n                full = m.group(0).strip(\" .,:;\")\n                if norm(site) and norm(site) in norm(full) and norm(full) != norm(site):\n                    pred[\"site\"] = full\n                    break\n            else:\n                for m in re.finditer(r\"\\\\b[A-ZÀ-Ý][\\\\w'’-]+(?:\\\\s+[A-ZÀ-Ý][\\\\w'’-]+){0,2}\\\\s+(?:Facility|Plant|Works)\\\\b\", t):\n                    full = m.group(0).strip(\" .,:;\")\n                    if norm(site) and norm(site) in norm(full) and norm(full) != norm(site):\n                        pred[\"site\"] = full\n                        break\n'''\nassert old in s\ns=s.replace(old,new); open(p,'w').write(s); print('ok')\nEOF\n# apply postprocess to existing outputs to verify without re-calling\n.venv/bin/python - <<'EOF'\nimport sys,json,glob,os,pymupdf,re,unicodedata\nsys.path.insert(0,'.'); import extraire as E\ndef norm(s): return E.norm(s)\nkeys=E.KEYS; ok=tot=0\nfor f in sorted(glob.glob('/tmp/sortie_fourni/*.json')):\n stem=os.path.basename(f)[:-5]; pred=json.load(open(f)); text=\"\\n\".join(p.get_text() for p in pymupdf.open('fourni/'+stem+'.pdf'))\n pred=E.text_postprocess(text,pred); ans=json.load(open('fourni/reponses/'+stem+'.json'))\n bad=[]\n for k in keys:\n  a=ans[k]; p=pred.get(k); good=False\n  if a is None: good=p is None\n  elif isinstance(a,(int,float)) and not isinstance(a,bool):\n   try: good=abs(float(p)-a)<=.011\n   except: good=False\n  elif k.startswith('date'): good=p==a\n  else: good=norm(p)==norm(a)\n  if good: ok+=1\n  else: bad.append((k,a,p))\n  tot+=1\n if bad: print(stem,bad)\nprint('TOTAL',ok,tot,ok/tot)\nEOF","time":{"start":1795128749509,"end":1795128749720}},"id":"prt_1f602e1c7001F0XcPIiV333Zhr","sessionID":"ses_e0a0e9139ffeueffAzFzUVtP7e","messageID":"msg_1f602c58d001XHtSSCiwN7qt0g"}}
