{"type":"tool_use","timestamp":1795128259143,"sessionID":"ses_e0a0e9139ffeueffAzFzUVtP7e","part":{"type":"tool","tool":"bash","callID":"chatcmpl-tool-9632f03d0d51e496","state":{"status":"completed","input":{"command":"cd /travail && cat > /tmp/post.py <<'EOF'\nimport re, unicodedata\n\ndef parse_num_units(num, unit):\n    s=num.strip().replace('\\u00a0',' ')\n    s=s.replace(\"'\",'').replace('’','').replace(' ','')\n    # French thousands comma? if both comma and dot, last separator decimal\n    if ',' in s and '.' in s:\n        if s.rfind(',')>s.rfind('.'):\n            s=s.replace('.','').replace(',','.')\n        else:\n            s=s.replace(',','')\n    elif ',' in s:\n        # comma as decimal if one comma and <=3 digits after, else thousands\n        parts=s.split(',')\n        if len(parts[-1])==3 and len(parts)==2 and len(parts[0])<=3:\n            # ambiguous; assume thousands only if integer-like? use decimal if value likely small? \n            pass\n        s=','.join(s.split(',')[:-1])+'.'+s.split(',')[-1] if s.count(',')==1 else s.replace(',','')\n    try: v=float(s)\n    except: return None\n    u=(unit or '').lower().replace(' ','')\n    if u in ('ml/min','mlmin'): return v\n    if u in ('l/h','lh'): return v*1000/60\n    if u in ('l/min','lmin'): return v*1000\n    if u in ('ml/s','mls'): return v*60\n    if u in ('ml/h','mlh'): return v/60\n    return None\n\ndef parse_pressure(num,unit):\n    v=None\n    s=num.strip().replace('\\u00a0',' ').replace(\"'\",'').replace('’','').replace(' ','')\n    if ',' in s and '.' in s:\n        if s.rfind(',')>s.rfind('.'): s=s.replace('.','').replace(',','.')\n        else: s=s.replace(',','')\n    elif ',' in s: s=s.replace(',','.')\n    try: v=float(s)\n    except: return None\n    u=(unit or '').lower().replace(' ','')\n    if u=='bar': return v\n    if u=='psi': return v/14.5038\n    if u=='kpa': return v/100\n    if u=='mbar': return v/1000\n    if u=='mpa': return v*10\n    return None\n\ndef text_post(text, pred):\n    t=text\n    # debit fallback if null\n    if pred.get('debit_ml_min') is None:\n        pats=[\n          r\"(?:d[ée]bit(?:\\s+volum[ée]trique)?[^\\n:]{0,40}apr[èe]s r[ée]glage\\s*:?\\s*)([0-9][0-9\\s.,'’]*)\\s*(ml/min|mL/min|L/h|l/h|ml/s|mL/s|L/min|l/min)\",\n          r\"(?:flow rate[^\\n:]{0,30}(?:as left|after adjustment)\\s*:?\\s*)([0-9][0-9\\s.,'’-]*)\\s*(ml/min|mL/min|L/h|l/h|ml/s|mL/s|L/min|l/min)\",\n          r\"(?:l'[ée]quipement\\s+d[ée]bite\\s+alors|the equipment (?:then )?delivers)\\s*([0-9][0-9\\s.,'’]*)\\s*(ml/min|mL/min|L/h|l/h|ml/s|mL/s|L/min|l/min)\",\n        ]\n        for p in pats:\n            m=re.search(p,t,re.I)\n            if m:\n                v=parse_num_units(m.group(1),m.group(2))\n                if v is not None: pred['debit_ml_min']=round(v,4); break\n    if pred.get('pression_bar') is None:\n        pats=[\n          r\"[ée]quipement.*?d[ée]bite.*?pression\", # nonsense placeholder\n          r\"pression(?: de service)?\\s+s'est stabilis[ée]e\\s+[àa]\\s*([0-9][0-9\\s.,'’]*)\\s*(bar|psi|mbar|kPa|MPa)\",\n          r\"pressure (?:settled|stabilised|stabilized) at\\s*([0-9][0-9\\s.,'’]*)\\s*(bar|psi|mbar|kPa|MPa)\",\n          r\"(?:pression(?: de service)?[^\\n:]{0,30}apr[èe]s r[ée]glage\\s*:?\\s*)([0-9][0-9\\s.,'’]*)\\s*(bar|psi|mbar|kPa|MPa)\",\n          r\"(?:operating pressure[^\\n:]{0,25}(?:as left|after adjustment)\\s*:?\\s*)([0-9][0-9\\s.,'’]*)\\s*(bar|psi|mbar|kPa|MPa)\",\n        ]\n        for p in pats:\n            m=re.search(p,t,re.I)\n            if m:\n                v=parse_pressure(m.group(1),m.group(2))\n                if v is not None: pred['pression_bar']=round(v,4); break\n    # serial O/0 fix using known text? only fix D0 -> DO heuristic for codes\n    s=pred.get('numero_serie')\n    if isinstance(s,str):\n        # common OCR: letter O misread as zero after first letter in 2-letter prefix\n        m=re.match(r'^([A-Z])0(\\d{4,})$',s)\n        if m: pred['numero_serie']=m.group(1)+'O'+m.group(2)\n    return pred\nEOF\n.venv/bin/python - <<'EOF'\nimport sys,json,glob,os,re,unicodedata,pymupdf as fitz\nsys.path.insert(0,'/tmp'); from post import text_post\nfrom post import text_post\ndef norm(s):\n if s is None:return None\n s=unicodedata.normalize('NFD',str(s)); s=''.join(c for c in s if unicodedata.category(c)!='Mn')\n return re.sub(r'\\s+',' ',s).strip().lower().replace('’',\"'\").replace('–','-')\nkeys=['machine','constructeur','numero_serie','site','reference_rapport','date_intervention','date_validation','volume_dose_ml','volume_nominal_ml','tolerance_ml','debit_ml_min','pression_bar','reference_piece','technicien','statut']\ntot=ok=0\nfor f in sorted(glob.glob('/tmp/llm_out2/*.json')):\n stem=os.path.basename(f)[:-5]; ans=json.load(open('fourni/reponses/'+stem+'.json')); pred=json.loads(open(f).read())\n text=\"\\n\".join(p.get_text() for p in fitz.open('fourni/'+stem+'.pdf'))\n pred=text_post(text,pred)\n bad=[]; tot+=15\n for k in keys:\n  a=ans[k]; p=pred.get(k); good=False\n  if a is None: good=(p is None)\n  elif isinstance(a,(int,float)) and not isinstance(a,bool):\n   try: good=abs(float(p)-a)<=0.011\n   except: good=False\n  elif k.startswith('date'): good=(p==a)\n  else: good=(norm(p)==norm(a))\n  if good: ok+=1\n  else: bad.append((k,a,p))\n if bad: print(stem,bad)\nprint('TOTAL',ok,tot,ok/tot)\nEOF"},"output":"TOTAL 525 525 1.0\n","metadata":{"output":"TOTAL 525 525 1.0\n","exit":0,"truncated":false},"title":"cd /travail && cat > /tmp/post.py <<'EOF'\nimport re, unicodedata\n\ndef parse_num_units(num, unit):\n    s=num.strip().replace('\\u00a0',' ')\n    s=s.replace(\"'\",'').replace('’','').replace(' ','')\n    # French thousands comma? if both comma and dot, last separator decimal\n    if ',' in s and '.' in s:\n        if s.rfind(',')>s.rfind('.'):\n            s=s.replace('.','').replace(',','.')\n        else:\n            s=s.replace(',','')\n    elif ',' in s:\n        # comma as decimal if one comma and <=3 digits after, else thousands\n        parts=s.split(',')\n        if len(parts[-1])==3 and len(parts)==2 and len(parts[0])<=3:\n            # ambiguous; assume thousands only if integer-like? use decimal if value likely small? \n            pass\n        s=','.join(s.split(',')[:-1])+'.'+s.split(',')[-1] if s.count(',')==1 else s.replace(',','')\n    try: v=float(s)\n    except: return None\n    u=(unit or '').lower().replace(' ','')\n    if u in ('ml/min','mlmin'): return v\n    if u in ('l/h','lh'): return v*1000/60\n    if u in ('l/min','lmin'): return v*1000\n    if u in ('ml/s','mls'): return v*60\n    if u in ('ml/h','mlh'): return v/60\n    return None\n\ndef parse_pressure(num,unit):\n    v=None\n    s=num.strip().replace('\\u00a0',' ').replace(\"'\",'').replace('’','').replace(' ','')\n    if ',' in s and '.' in s:\n        if s.rfind(',')>s.rfind('.'): s=s.replace('.','').replace(',','.')\n        else: s=s.replace(',','')\n    elif ',' in s: s=s.replace(',','.')\n    try: v=float(s)\n    except: return None\n    u=(unit or '').lower().replace(' ','')\n    if u=='bar': return v\n    if u=='psi': return v/14.5038\n    if u=='kpa': return v/100\n    if u=='mbar': return v/1000\n    if u=='mpa': return v*10\n    return None\n\ndef text_post(text, pred):\n    t=text\n    # debit fallback if null\n    if pred.get('debit_ml_min') is None:\n        pats=[\n          r\"(?:d[ée]bit(?:\\s+volum[ée]trique)?[^\\n:]{0,40}apr[èe]s r[ée]glage\\s*:?\\s*)([0-9][0-9\\s.,'’]*)\\s*(ml/min|mL/min|L/h|l/h|ml/s|mL/s|L/min|l/min)\",\n          r\"(?:flow rate[^\\n:]{0,30}(?:as left|after adjustment)\\s*:?\\s*)([0-9][0-9\\s.,'’-]*)\\s*(ml/min|mL/min|L/h|l/h|ml/s|mL/s|L/min|l/min)\",\n          r\"(?:l'[ée]quipement\\s+d[ée]bite\\s+alors|the equipment (?:then )?delivers)\\s*([0-9][0-9\\s.,'’]*)\\s*(ml/min|mL/min|L/h|l/h|ml/s|mL/s|L/min|l/min)\",\n        ]\n        for p in pats:\n            m=re.search(p,t,re.I)\n            if m:\n                v=parse_num_units(m.group(1),m.group(2))\n                if v is not None: pred['debit_ml_min']=round(v,4); break\n    if pred.get('pression_bar') is None:\n        pats=[\n          r\"[ée]quipement.*?d[ée]bite.*?pression\", # nonsense placeholder\n          r\"pression(?: de service)?\\s+s'est stabilis[ée]e\\s+[àa]\\s*([0-9][0-9\\s.,'’]*)\\s*(bar|psi|mbar|kPa|MPa)\",\n          r\"pressure (?:settled|stabilised|stabilized) at\\s*([0-9][0-9\\s.,'’]*)\\s*(bar|psi|mbar|kPa|MPa)\",\n          r\"(?:pression(?: de service)?[^\\n:]{0,30}apr[èe]s r[ée]glage\\s*:?\\s*)([0-9][0-9\\s.,'’]*)\\s*(bar|psi|mbar|kPa|MPa)\",\n          r\"(?:operating pressure[^\\n:]{0,25}(?:as left|after adjustment)\\s*:?\\s*)([0-9][0-9\\s.,'’]*)\\s*(bar|psi|mbar|kPa|MPa)\",\n        ]\n        for p in pats:\n            m=re.search(p,t,re.I)\n            if m:\n                v=parse_pressure(m.group(1),m.group(2))\n                if v is not None: pred['pression_bar']=round(v,4); break\n    # serial O/0 fix using known text? only fix D0 -> DO heuristic for codes\n    s=pred.get('numero_serie')\n    if isinstance(s,str):\n        # common OCR: letter O misread as zero after first letter in 2-letter prefix\n        m=re.match(r'^([A-Z])0(\\d{4,})$',s)\n        if m: pred['numero_serie']=m.group(1)+'O'+m.group(2)\n    return pred\nEOF\n.venv/bin/python - <<'EOF'\nimport sys,json,glob,os,re,unicodedata,pymupdf as fitz\nsys.path.insert(0,'/tmp'); from post import text_post\nfrom post import text_post\ndef norm(s):\n if s is None:return None\n s=unicodedata.normalize('NFD',str(s)); s=''.join(c for c in s if unicodedata.category(c)!='Mn')\n return re.sub(r'\\s+',' ',s).strip().lower().replace('’',\"'\").replace('–','-')\nkeys=['machine','constructeur','numero_serie','site','reference_rapport','date_intervention','date_validation','volume_dose_ml','volume_nominal_ml','tolerance_ml','debit_ml_min','pression_bar','reference_piece','technicien','statut']\ntot=ok=0\nfor f in sorted(glob.glob('/tmp/llm_out2/*.json')):\n stem=os.path.basename(f)[:-5]; ans=json.load(open('fourni/reponses/'+stem+'.json')); pred=json.loads(open(f).read())\n text=\"\\n\".join(p.get_text() for p in fitz.open('fourni/'+stem+'.pdf'))\n pred=text_post(text,pred)\n bad=[]; tot+=15\n for k in keys:\n  a=ans[k]; p=pred.get(k); good=False\n  if a is None: good=(p is None)\n  elif isinstance(a,(int,float)) and not isinstance(a,bool):\n   try: good=abs(float(p)-a)<=0.011\n   except: good=False\n  elif k.startswith('date'): good=(p==a)\n  else: good=(norm(p)==norm(a))\n  if good: ok+=1\n  else: bad.append((k,a,p))\n if bad: print(stem,bad)\nprint('TOTAL',ok,tot,ok/tot)\nEOF","time":{"start":1795128258950,"end":1795128259131}},"id":"prt_1f5fb5955001d4NvJs7kpaZXxf","sessionID":"ses_e0a0e9139ffeueffAzFzUVtP7e","messageID":"msg_1f5fb0f4c00121NcDpTHqhqFSJ"}}
