{"type":"tool_use","timestamp":1795128225752,"sessionID":"ses_e0a0e9139ffeueffAzFzUVtP7e","part":{"type":"tool","tool":"bash","callID":"chatcmpl-tool-a8cc0c4f3aeb1400","state":{"status":"completed","input":{"command":"cd /travail && .venv/bin/python - <<'EOF'\nimport json,glob,os,re,unicodedata\ndef norm(s):\n if s is None:return None\n s=unicodedata.normalize('NFD',str(s)); s=''.join(c for c in s if unicodedata.category(c)!='Mn')\n return re.sub(r'\\s+',' ',s).strip().lower().replace('’',\"'\").replace('–','-')\nkeys=['machine','constructeur','numero_serie','site','reference_rapport','date_intervention','date_validation','volume_dose_ml','volume_nominal_ml','tolerance_ml','debit_ml_min','pression_bar','reference_piece','technicien','statut']\ntot=ok=0; fieldok={k:0 for k in keys}; fieldn={k:0 for k in keys}\nfor f in sorted(glob.glob('/tmp/llm_out2/*.json')):\n stem=os.path.basename(f)[:-5]; ans=json.load(open('fourni/reponses/'+stem+'.json'))\n try: pred=json.loads(open(f).read())\n except Exception as e: print('parse fail',stem,e); continue\n bad=[]\n for k in keys:\n  fieldn[k]+=1; tot+=1; a=ans[k]; p=pred.get(k); good=False\n  if a is None: good=(p is None)\n  elif isinstance(a,(int,float)) and not isinstance(a,bool):\n   try: good=abs(float(p)-a)<=0.011\n   except: good=False\n  elif k.startswith('date'): good=(p==a)\n  else: good=(norm(p)==norm(a))\n  if good: ok+=1; fieldok[k]+=1\n  else: bad.append((k,a,p))\n if bad: print(stem,'BAD',bad)\nprint('TOTAL',ok,'/',tot,round(ok/tot,4))\nfor k in keys: print(k,fieldok[k],'/',fieldn[k],round(fieldok[k]/fieldn[k],3))\nEOF"},"output":"doc-002 BAD [('debit_ml_min', 447.0, None)]\ndoc-007 BAD [('numero_serie', 'DO900934', 'D0900934')]\ndoc-012 BAD [('debit_ml_min', 2780.0, None)]\nTOTAL 522 / 525 0.9943\nmachine 35 / 35 1.0\nconstructeur 35 / 35 1.0\nnumero_serie 34 / 35 0.971\nsite 35 / 35 1.0\nreference_rapport 35 / 35 1.0\ndate_intervention 35 / 35 1.0\ndate_validation 35 / 35 1.0\nvolume_dose_ml 35 / 35 1.0\nvolume_nominal_ml 35 / 35 1.0\ntolerance_ml 35 / 35 1.0\ndebit_ml_min 33 / 35 0.943\npression_bar 35 / 35 1.0\nreference_piece 35 / 35 1.0\ntechnicien 35 / 35 1.0\nstatut 35 / 35 1.0\n","metadata":{"output":"doc-002 BAD [('debit_ml_min', 447.0, None)]\ndoc-007 BAD [('numero_serie', 'DO900934', 'D0900934')]\ndoc-012 BAD [('debit_ml_min', 2780.0, None)]\nTOTAL 522 / 525 0.9943\nmachine 35 / 35 1.0\nconstructeur 35 / 35 1.0\nnumero_serie 34 / 35 0.971\nsite 35 / 35 1.0\nreference_rapport 35 / 35 1.0\ndate_intervention 35 / 35 1.0\ndate_validation 35 / 35 1.0\nvolume_dose_ml 35 / 35 1.0\nvolume_nominal_ml 35 / 35 1.0\ntolerance_ml 35 / 35 1.0\ndebit_ml_min 33 / 35 0.943\npression_bar 35 / 35 1.0\nreference_piece 35 / 35 1.0\ntechnicien 35 / 35 1.0\nstatut 35 / 35 1.0\n","exit":0,"truncated":false},"title":"cd /travail && .venv/bin/python - <<'EOF'\nimport json,glob,os,re,unicodedata\ndef norm(s):\n if s is None:return None\n s=unicodedata.normalize('NFD',str(s)); s=''.join(c for c in s if unicodedata.category(c)!='Mn')\n return re.sub(r'\\s+',' ',s).strip().lower().replace('’',\"'\").replace('–','-')\nkeys=['machine','constructeur','numero_serie','site','reference_rapport','date_intervention','date_validation','volume_dose_ml','volume_nominal_ml','tolerance_ml','debit_ml_min','pression_bar','reference_piece','technicien','statut']\ntot=ok=0; fieldok={k:0 for k in keys}; fieldn={k:0 for k in keys}\nfor f in sorted(glob.glob('/tmp/llm_out2/*.json')):\n stem=os.path.basename(f)[:-5]; ans=json.load(open('fourni/reponses/'+stem+'.json'))\n try: pred=json.loads(open(f).read())\n except Exception as e: print('parse fail',stem,e); continue\n bad=[]\n for k in keys:\n  fieldn[k]+=1; tot+=1; a=ans[k]; p=pred.get(k); good=False\n  if a is None: good=(p is None)\n  elif isinstance(a,(int,float)) and not isinstance(a,bool):\n   try: good=abs(float(p)-a)<=0.011\n   except: good=False\n  elif k.startswith('date'): good=(p==a)\n  else: good=(norm(p)==norm(a))\n  if good: ok+=1; fieldok[k]+=1\n  else: bad.append((k,a,p))\n if bad: print(stem,'BAD',bad)\nprint('TOTAL',ok,'/',tot,round(ok/tot,4))\nfor k in keys: print(k,fieldok[k],'/',fieldn[k],round(fieldok[k]/fieldn[k],3))\nEOF","time":{"start":1795128225730,"end":1795128225751}},"id":"prt_1f5faeb3a001Tbd766q3gxln2M","sessionID":"ses_e0a0e9139ffeueffAzFzUVtP7e","messageID":"msg_1f5fae118001wTJfbDBQE0qz2y"}}
