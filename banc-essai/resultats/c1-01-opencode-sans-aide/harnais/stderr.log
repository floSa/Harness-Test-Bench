timestamp=2026-11-19T22:52:29.508Z level=INFO run=155d86aa message=evaluated permission=bash pattern=".venv/bin/python - <<'EOF'\nimport sys,json,glob,os,pymupdf,re,unicodedata\nsys.path.insert(0,'.'); import extraire as E\ndef norm(s): return E.norm(s)\nkeys=E.KEYS; ok=tot=0\nfor f in sorted(glob.glob('/tmp/sortie_fourni/*.json')):\n stem=os.path.basename(f)[:-5]; pred=json.load(open(f)); text=\"\\n\".join(p.get_text() for p in pymupdf.open('fourni/'+stem+'.pdf'))\n pred=E.text_postprocess(text,pred); ans=json.load(open('fourni/reponses/'+stem+'.json'))\n bad=[]\n for k in keys:\n  a=ans[k]; p=pred.get(k); good=False\n  if a is None: good=p is None\n  elif isinstance(a,(int,float)) and not isinstance(a,bool):\n   try: good=abs(float(p)-a)<=.011\n   except: good=False\n  elif k.startswith('date'): good=p==a\n  else: good=norm(p)==norm(a)\n  if good: ok+=1\n  else: bad.append((k,a,p))\n  tot+=1\n if bad: print(stem,bad)\nprint('TOTAL',ok,tot,ok/tot)\nEOF" action.permission=bash action.action=allow action.pattern=*
