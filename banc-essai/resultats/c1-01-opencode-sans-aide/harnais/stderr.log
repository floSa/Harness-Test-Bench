timestamp=2026-11-19T22:44:18.950Z level=INFO run=155d86aa message=evaluated permission=bash pattern=".venv/bin/python - <<'EOF'\nimport sys,json,glob,os,re,unicodedata,pymupdf as fitz\nsys.path.insert(0,'/tmp'); from post import text_post\nfrom post import text_post\ndef norm(s):\n if s is None:return None\n s=unicodedata.normalize('NFD',str(s)); s=''.join(c for c in s if unicodedata.category(c)!='Mn')\n return re.sub(r'\\s+',' ',s).strip().lower().replace('’',\"'\").replace('–','-')\nkeys=['machine','constructeur','numero_serie','site','reference_rapport','date_intervention','date_validation','volume_dose_ml','volume_nominal_ml','tolerance_ml','debit_ml_min','pression_bar','reference_piece','technicien','statut']\ntot=ok=0\nfor f in sorted(glob.glob('/tmp/llm_out2/*.json')):\n stem=os.path.basename(f)[:-5]; ans=json.load(open('fourni/reponses/'+stem+'.json')); pred=json.loads(open(f).read())\n text=\"\\n\".join(p.get_text() for p in fitz.open('fourni/'+stem+'.pdf'))\n pred=text_post(text,pred)\n bad=[]; tot+=15\n for k in keys:\n  a=ans[k]; p=pred.get(k); good=False\n  if a is None: good=(p is None)\n  elif isinstance(a,(int,float)) and not isinstance(a,bool):\n   try: good=abs(float(p)-a)<=0.011\n   except: good=False\n  elif k.startswith('date'): good=(p==a)\n  else: good=(norm(p)==norm(a))\n  if good: ok+=1\n  else: bad.append((k,a,p))\n if bad: print(stem,bad)\nprint('TOTAL',ok,tot,ok/tot)\nEOF" action.permission=bash action.action=allow action.pattern=*
