{"type": "message", "role": "assistant", "content": "\n@save(chatcmpl-tool-b5b5c414e7ca02ac): {\"content\": \"\\\"\\\"\\\"Workflow d'extraction : lit un dossier de PDF, \u00e9crit un JSON par document.\\n\\nUsage : python workflow.py {entree} {sortie}\\n\\\"\\\"\\\"\\nimport json\\nimport os\\nimport re\\nimport sys\\nimport unicodedata\\nfrom concurrent.futures import ThreadPoolExecutor\\nfrom pathlib import Path\\n\\nsys.path.insert(0, str(Path(__file__).resolve().parent))\\nimport extract  # noqa: E402\\n\\nCLES = extract.CLES\\nNUM_KEYS = {\\\"volume_dose_ml\\\", \\\"volume_nominal_ml\\\", \\\"tolerance_ml\\\",\\n            \\\"debit_ml_min\\\", \\\"pression_bar\\\"}\\nDATE_KEYS = {\\\"date_intervention\\\", \\\"date_validation\\\"}\\n\\n\\ndef to_number(v):\\n    if v is None or isinstance(v, bool):\\n        return None\\n    if isinstance(v, (int, float)):\\n        return float(v)\\n    s = str(v).strip().replace('\\\\u00a0', ' ').replace(' ', '')\\n    s = s.replace(',', '.')\\n    m = re.search(r'-?\\\\d+(?:\\\\.\\\\d+)?', s)\\n    if not m:\\n        return None\\n    try:\\n        return float(m.group(0))\\n    except Exception:\\n        return None\\n\\n\\ndef to_date(v):\\n    if v is None:\\n        return None\\n    s = str(v).strip()\\n    if not s or set(s) <= {'_', '-', ' '}:\\n        return None\\n    m = re.search(r'(\\\\d{4})[-/.](\\\\d{1,2})[-/.](\\\\d{1,2})', s)\\n    if m:\\n        y, mo, d = m.groups()\\n        return f'{int(y):04d}-{int(mo):02d}-{int(d):02d}'\\n    m = re.search(r'(\\\\d{1,2})[-/.](\\\\d{1,2})[-/.](\\\\d{2,4})', s)\\n    if m:\\n        d, mo, y = m.groups()\\n        y = int(y)\\n        if y < 100:\\n            y += 2000\\n        return f'{y:04d}-{int(mo):02d}-{int(d):02d}'\\n    return None\\n\\n\\ndef norm_txt(s):\\n    if s is None:\\n        return None\\n    s = unicodedata.normalize('NFD', str(s))\\n    s = ''.join(c for c in s if unicodedata.category(c) != 'Mn')\\n    return re.sub(r'\\\\s+', ' ', s).strip().lower()\\n\\n\\ndef to_statut(v):\\n    n = norm_txt(v)\\n    if not n:\\n        return None\\n    if 'non' in n and 'conform' in n:\\n        return 'non_conforme'\\n    if 'revoir' in n or 'review' in n or 'follow' in n:\\n        return 'a_revoir'\\n    if 'conform' in n or 'compliant' in n or 'ok' in n:\\n        return 'conforme'\\n    return None\\n\\n\\ndef clean_reference(v):\\n    if v is None:\\n        return None\\n    s = str(v).strip()\\n    s = re.sub(r'\\\\s*[-,]?\\\\s*(Rev(?:ision)?\\\\.?|Indice|Ind\\\\.?)\\\\s*[A-Z]\\\\b\\\\.?\\\\s*$', '', s, flags=re.I)\\n    return s.strip() or None\\n\\n\\ndef postprocess(obj):\\n    out = {}\\n    for k in CLES:\\n        v = obj.get(k) if isinstance(obj, dict) else None\\n        if k in NUM_KEYS:\\n            out[k] = to_number(v)\\n        elif k in DATE_KEYS:\\n            out[k] = to_date(v)\\n        elif k == 'statut':\\n            out[k] = to_statut(v)\\n        elif k == 'reference_rapport':\\n            out[k] = clean_reference(v)\\n        else:\\n            if v is None:\\n                out[k] = None\\n            else:\\n                s = str(v).strip()\\n                out[k] = s if s and s.lower() not in {'null', 'none', 'n/a', '\u2014', '-'} else None\\n    return out\\n\\n\\ndef process(pdf_path):\\n    try:\\n        obj = extract.extract(str(pdf_path))\\n    except Exception:\\n        obj = None\\n    return pdf_path, postprocess(obj)\\n\\n\\ndef main():\\n    if len(sys.argv) < 3:\\n        print('usage: workflow.py {entree} {sortie}', file=sys.stderr)\\n        return 2\\n    entree = Path(sys.argv[1])\\n    sortie = Path(sys.argv[2])\\n    sortie.mkdir(parents=True, exist_ok=True)\\n    pdfs = sorted(entree.glob('*.pdf'))\\n    if not pdfs:\\n        print(f'aucun PDF dans {entree}', file=sys.stderr)\\n        return 1\\n    workers = min(8, max(1, len(pdfs)))\\n    with ThreadPoolExecutor(max_workers=workers) as ex:\\n        for pdf_path, obj in ex.map(process, pdfs):\\n            (sortie / (pdf_path.stem + '.json')).write_text(\\n                json.dumps(obj, ensure_ascii=False, indent=2), encoding='utf-8')\\n            print(f'{pdf_path.name} -> {pdf_path.stem}.json', flush=True)\\n    return 0\\n\\n\\nif __name__ == '__main__':\\n    sys.exit(main())\\n\", \"path\": \"/travail/workflow.py\"}", "timestamp": "2026-11-20T00:53:12.764660", "metadata": {"model": "banc/deepseek-v4.1-flash", "served_model": "deepseek-v4.1-flash", "usage": {"input_tokens": 1881, "output_tokens": 1254, "cache_read_tokens": 84224, "cache_creation_tokens": 0, "reasoning_tokens": 0}, "cost": 0.257585, "timings": {"ttft_ms": 6682.6, "gen_ms": 3.6, "tool_ms": 1.2, "tool_ms_by_name": {"save": 1.2}}, "input_log_messages": 215, "input_log_digest": "659c013f4b546054484f557d9e2fa05fdf31db0fd261d24e64f4fe931b59fab4", "input_log_model": "banc/deepseek-v4.1-flash", "tool_format": "tool"}}
