# Modèle servi aux harnais par le relais du banc (LiteLLM, 127.0.0.1:4100), via le portail compatible
# OpenAI dont l'adresse et la clé sont dans .env (PORTAIL_URL, PORTAIL_CLE).
#
# Fichier lu par banc-essai/traces/demarrer.sh (configuration du relais), banc-essai/traces/cles.py
# (modèle et plafond des clés d'essai) et banc-essai/cage/cage.sh (variables transmises aux harnais).
# Aucune clé ici. Après une modification : banc-essai/traces/demarrer.sh.
# Guide : banc-essai/documentation/modele-et-fournisseur.md.

# Nom du modèle chez le portail, tel que rendu par GET <PORTAIL_URL>/models
# (python3 banc-essai/traces/verifier_portail.py le vérifie). À REMPLIR.
BANC_MODELE_FOURNISSEUR=

# Nom sous lequel les harnais voient le modèle (lettres, chiffres, points, tirets).
BANC_MODELE=modele-banc

# Capacités du modèle, déclarées aux harnais : fenêtre de contexte et sortie maximale en jetons,
# lecture d'images (1 : oui, 0 : non). À REMPLACER par les valeurs du portail (documentation du
# portail ; vision : résultat de verifier_portail.py).
BANC_CONTEXTE=128000
BANC_SORTIE_MAX=16384
BANC_VISION=0

# Prix en dollars par million de jetons (entrée, entrée lue dans le cache, sortie). Le relais en
# tire le coût de chaque appel et bloque une clé d'essai au-delà de son plafond. Portail sans prix :
# prix conventionnels de 1, le plafond devient un plafond en millions de jetons.
BANC_PRIX_ENTREE=1
BANC_PRIX_CACHE=1
BANC_PRIX_SORTIE=1

# Plafond d'une clé d'essai (avec les prix conventionnels : 40 millions de jetons).
BANC_BUDGET_ESSAI=40
