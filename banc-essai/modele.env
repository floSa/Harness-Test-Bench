# Modèle servi aux harnais par le relais du banc (LiteLLM, 127.0.0.1:4100).
#
# Fichier lu par banc-essai/traces/demarrer.sh (configuration du relais), banc-essai/traces/cles.py
# (modèle et plafond des clés d'essai) et banc-essai/cage/cage.sh (variables transmises aux harnais,
# qui en tirent leur configuration). Aucune clé ici : les clés sont dans .env, à la racine du dépôt.
# Après une modification : banc-essai/traces/demarrer.sh (le relais relit sa configuration).
# Guide : banc-essai/documentation/modele-et-fournisseur.md.

# Fournisseur : « openrouter » (clé OPENROUTER_API_KEY dans .env) ou « portail » (tout point
# d'accès compatible OpenAI : PORTAIL_URL et PORTAIL_CLE dans .env).
BANC_FOURNISSEUR=openrouter

# Nom du modèle chez le fournisseur (OpenRouter : « auteur/modèle » ; portail : nom donné par
# GET <PORTAIL_URL>/models).
BANC_MODELE_FOURNISSEUR=deepseek/deepseek-v4.1-flash-1017

# OpenRouter seulement : fournisseur imposé, sans repli (vide : choix d'OpenRouter).
BANC_OPENROUTER_ORDRE=pearl-research

# Nom sous lequel les harnais voient le modèle (lettres, chiffres, points, tirets).
BANC_MODELE=deepseek-v4.1-flash

# Capacités du modèle, déclarées aux harnais qui les demandent (OpenCode, Pi) : fenêtre de
# contexte et sortie maximale en jetons, lecture d'images (1 : oui, 0 : non).
BANC_CONTEXTE=1000000
BANC_SORTIE_MAX=32768
BANC_VISION=1

# Prix en dollars par million de jetons (entrée, entrée lue dans le cache, sortie). Le relais en
# tire le coût de chaque appel et bloque une clé d'essai au-delà de son plafond. Sans prix connu
# (portail interne), garder des prix conventionnels : le plafond devient alors un plafond de jetons.
BANC_PRIX_ENTREE=0.05
BANC_PRIX_CACHE=0.003
BANC_PRIX_SORTIE=0.30

# Plafond de dépense d'une clé d'essai, en dollars (calculé avec les prix ci-dessus).
BANC_BUDGET_ESSAI=2
