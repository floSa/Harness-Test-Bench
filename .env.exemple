# Modèle de .env (à copier en .env à la racine du dépôt, jamais commité : chmod 600 .env).
# Seules les variables du fournisseur choisi dans banc-essai/modele.env (BANC_FOURNISSEUR) sont lues.

# Fournisseur « openrouter »
OPENROUTER_API_KEY=

# Fournisseur « portail » (tout point d'accès compatible OpenAI) : adresse de base avec le /v1 final,
# sans /chat/completions ; clé d'API du portail.
PORTAIL_URL=
PORTAIL_CLE=

# Poste d'entreprise, facultatif : mandataire HTTP sortant (http://hote:port, ou
# http://identifiant:mot-de-passe@hote:port) et fichier PEM des autorités de confiance
# (autorité interne comprise). La vérification des certificats n'est jamais désactivée.
BANC_MANDATAIRE=
BANC_CERTIFICAT=
