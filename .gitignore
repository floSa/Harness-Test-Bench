banc-essai/corpus/test-cache/
banc-essai/corpus/relance/
# Environnements
.venv/
__pycache__/
node_modules/
# Détail par document des soumissions au test caché (révèle la vérité)
banc-essai/resultats/*/evaluation/detail-cache.jsonl
banc-essai/resultats/*/evaluation/contenus-cache.jsonl
banc-essai/resultats/*/code-cache/
