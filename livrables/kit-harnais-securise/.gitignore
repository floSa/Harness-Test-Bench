# Réglages avec clés : jamais versionnés ni partagés.
.env
# Fichiers du test et journaux : propres à chaque poste.
espace/*
journaux/*
certificats/*
!*/.gitkeep
# Mode sans conteneur : harnais installé, dossier personnel du harnais, verrou de session.
sans-conteneur/harnais/
sans-conteneur/maison/
sans-conteneur/.verrou
