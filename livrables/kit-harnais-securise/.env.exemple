# Réglages du kit. Copier en .env (preparer.sh le fait), compléter, ne jamais partager ni versionner.

# --- Portail IAG (obligatoire) ---
# Adresse de l'API compatible OpenAI, avec le /v1 final, sans /chat/completions.
IAG_URL=https://portail-iag.exemple/v1
# Clé personnelle du portail. Seul le relais la lit.
IAG_CLE=
# Modèle utilisé par le harnais (nom exact donné par le portail).
IAG_MODELE=
# Autres modèles autorisés, séparés par des virgules (facultatif ; par défaut : IAG_MODELE seul).
IAG_MODELES=

# --- Limites (valeurs par défaut raisonnables pour une journée de test) ---
PLAFOND_JETONS=30000000
APPELS_PAR_MINUTE=60
APPELS_SIMULTANES=4
MEMOIRE_MAX=8g
CPU_MAX=4

# --- Téléchargements autorisés au harnais (paquets Python et Node) ---
DOMAINES_AUTORISES=pypi.org,files.pythonhosted.org,registry.npmjs.org
QUOTA_TELECHARGEMENT_MO=5000

# --- Réseau d'entreprise (seulement si nécessaire) ---
# Mandataire sortant, utilisé par le relais et le filtre :
# HTTPS_PROXY=http://mandataire.exemple:8080
# NO_PROXY=localhost,127.0.0.1
# Certificat de l'autorité interne, déposé dans certificats/ :
# SSL_CERT_FILE=/certificats/autorite-interne.pem

# --- Portail particulier (seulement si sa documentation l'exige) ---
# Clé dans un autre en-tête que « Authorization: Bearer » (ex. api-key) :
# IAG_ENTETE_CLE=api-key
# En-têtes fixes, en JSON :
# IAG_ENTETES={"X-Application": "test-harnais"}
# Autres routes que /v1/chat/completions (ex. harnais qui utilise /v1/responses) :
# ROUTES_SUPPLEMENTAIRES=/v1/responses
# Ne pas demander le compte des jetons dans les réponses en flux (si le portail refuse stream_options) :
# COMPTER_FLUX=0
